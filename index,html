+<!DOCTYPE html>
+<html lang="ko">
+  <head>
+    <meta charset="UTF-8" />
+    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
+    <title>홍보자료 일별 아카이브</title>
+    <style>
+      :root {
+        --bg: #f6f8fb;
+        --text: #1f2937;
+        --muted: #6b7280;
+        --card: #ffffff;
+        --line: #e5e7eb;
+        --brand: #2563eb;
+        --brand-hover: #1d4ed8;
+      }
+
+      * {
+        box-sizing: border-box;
+      }
+
+      body {
+        margin: 0;
+        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto,
+          "Noto Sans KR", "Apple SD Gothic Neo", sans-serif;
+        background: var(--bg);
+        color: var(--text);
+      }
+
+      .container {
+        max-width: 1100px;
+        margin: 0 auto;
+        padding: 24px;
+      }
+
+      h1 {
+        margin: 8px 0 6px;
+        font-size: 2rem;
+      }
+
+      .subtitle {
+        margin: 0 0 24px;
+        color: var(--muted);
+      }
+
+      .date-section {
+        margin-bottom: 36px;
+      }
+
+      .date-title {
+        margin: 0 0 14px;
+        font-size: 1.4rem;
+      }
+
+      .card-grid {
+        display: grid;
+        grid-template-columns: repeat(auto-fill, minmax(270px, 1fr));
+        gap: 16px;
+      }
+
+      .card {
+        background: var(--card);
+        border: 1px solid var(--line);
+        border-radius: 14px;
+        overflow: hidden;
+        box-shadow: 0 4px 14px rgba(31, 41, 55, 0.07);
+        display: flex;
+        flex-direction: column;
+      }
+
+      .card-image {
+        aspect-ratio: 16 / 10;
+        object-fit: cover;
+        width: 100%;
+        background: #eef2ff;
+      }
+
+      .card-body {
+        padding: 14px;
+        display: flex;
+        flex-direction: column;
+        gap: 10px;
+      }
+
+      .card-title {
+        margin: 0;
+        font-size: 1rem;
+        line-height: 1.45;
+      }
+
+      .card-date {
+        margin: 0;
+        color: var(--muted);
+        font-size: 0.92rem;
+      }
+
+      .card-description {
+        margin: 0;
+        font-size: 0.95rem;
+        line-height: 1.5;
+      }
+
+      .download-btn {
+        margin-top: 6px;
+        display: inline-block;
+        background: var(--brand);
+        color: white;
+        text-decoration: none;
+        padding: 10px 12px;
+        border-radius: 10px;
+        text-align: center;
+        font-weight: 600;
+      }
+
+      .download-btn:hover {
+        background: var(--brand-hover);
+      }
+    </style>
+  </head>
+  <body>
+    <main class="container">
+      <h1>홍보자료 일별 아카이브</h1>
+      <p class="subtitle">날짜별로 홍보 이미지를 카드 형태로 모아볼 수 있어요.</p>
+      <div id="archive"></div>
+    </main>
+
+    <script>
+      const promotions = [
+        {
+          title: "2026-05-05 전북현대모터스 홈경기 특별노선1994 운행안내",
+          date: "2026-05-05",
+          description:
+            "홈경기 당일 특별노선 1994 운행 시간과 탑승 위치를 안내하는 홍보자료입니다.",
+          image: "assets/2026-05-05-jeonbuk-special-route-1994.svg",
+          download: "assets/2026-05-05-jeonbuk-special-route-1994.svg",
+        },
+      ];
+
+      function groupByDate(items) {
+        return items.reduce((grouped, item) => {
+          if (!grouped[item.date]) grouped[item.date] = [];
+          grouped[item.date].push(item);
+          return grouped;
+        }, {});
+      }
+
+      function renderArchive(items) {
+        const archive = document.getElementById("archive");
+        const grouped = groupByDate(items);
+        const sortedDates = Object.keys(grouped).sort((a, b) => b.localeCompare(a));
+
+        sortedDates.forEach((date) => {
+          const section = document.createElement("section");
+          section.className = "date-section";
+
+          const heading = document.createElement("h2");
+          heading.className = "date-title";
+          heading.textContent = date;
+
+          const grid = document.createElement("div");
+          grid.className = "card-grid";
+
+          grouped[date].forEach((item) => {
+            const card = document.createElement("article");
+            card.className = "card";
+
+            card.innerHTML = `
+              <img class="card-image" src="${item.image}" alt="${item.title}" loading="lazy" />
+              <div class="card-body">
+                <h3 class="card-title">${item.title}</h3>
+                <p class="card-date">날짜: ${item.date}</p>
+                <p class="card-description">${item.description}</p>
+                <a class="download-btn" href="${item.download}" download>다운로드</a>
+              </div>
+            `;
+
+            grid.appendChild(card);
+          });
+
+          section.appendChild(heading);
+          section.appendChild(grid);
+          archive.appendChild(section);
+        });
+      }
+
+      renderArchive(promotions);
+    </script>
+  </body>
+</html>
